# auto selects OpenRouter when its key is present; otherwise local Ollama.
# Choose ollama or openrouter explicitly to pin a provider.
MODEL_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M
# Optional OpenAI-compatible LOCAL server (LM Studio / llama.cpp)
LOCAL_MODEL_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL=local-model-name
PORT=3000
# Optional: a licensed fictional voice. Server-only. Never prefix with VITE_.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3_conversational

# Hosted open-weight inference through the local Node backend (not a public multi-user server)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
