{
  "name": "deadnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nora Vale died in room 317. Her computer is still answering.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --include .env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "tsc --noEmit",
    "demo:build": "vite build --mode exhibition --outDir dist-demo",
    "verify:live": "tsx scripts/live-check.ts",
    "games:build": "node scripts/build-games.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.78.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-rnd": "^10.5.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
